# Optional: backend API URL (no .env needed for simulators/emulators)
# - iOS Simulator uses http://localhost:8000 by default
# - Android Emulator uses http://10.0.2.2:8000 by default
# - Physical device: set your computer's LAN IP so the phone can reach the backend, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
